# Копируйте в .env и заполните. .env не коммитится (.gitignore).
#
# СХЕМА: ОДИН эндпоинт + три model_id (+ опционально judge).
# Все SUT-модели (base + 2 fine-tune) обслуживаются одним
# OpenAI-совместимым эндпоинтом; в .env меняются только ID моделей.

# --- Единственный SUT-эндпоинт ---------------------------------------------------
# Base URL OpenAI-совместимого API (/v1). Query-строка (например ?token=...)
# передаётся SDK'ом в каждый запрос — проверено на openai 1.58.
SUT_BASE_URL=http://<host>:<port>/v1
SUT_API_KEY=sk-dummy

# --- ID трёх моделей под тестом ---------------------------------------------------
# Должны совпадать с выводом GET <SUT_BASE_URL>/models.
SUT_MODEL_ID_BASE=my-base-model
SUT_MODEL_ID_FINETUNE_A=my-finetune-a
SUT_MODEL_ID_FINETUNE_B=my-finetune-b

# --- Judge/expansion (опционально; первый прогон — без judge) ---------------------
# Нужен только бенчмаркам с needs_judge=true (mitre). Пока пусто -> run.sh
# пропускает judge, smoke_test.py не проверяет.
JUDGE_BASE_URL=
JUDGE_MODEL_ID=
JUDGE_API_KEY=
