# Копируйте в .env и заполните. .env не коммитится (.gitignore).
# Для vLLM/SGLang/LM Studio API key может быть ЛЮБЫМ непустым значением (например "sk-dummy").

# --- SUT-эндпоинты (base + 2 fine-tune) -------------------------------------
# Если все три модели живут на одном эндпоинте — укажите один и тот же URL,
# но разные model_id в config/models.yaml.
SUT_BASE_URL_1=http://<gpu-host>:8001/v1
SUT_MODEL_NOTE_1=base-model-served-by-vllm
SUT_API_KEY_1=sk-dummy

SUT_BASE_URL_2=http://<gpu-host>:8002/v1
SUT_API_KEY_2=sk-dummy

SUT_BASE_URL_3=http://<gpu-host>:8003/v1
SUT_API_KEY_3=sk-dummy

# --- Judge/expansion (отдельный эндпоинт, другая семья моделей) --------------
JUDGE_BASE_URL=https://api.example.com/v1
JUDGE_MODEL_NOTE=strong-general-purpose-model-other-family
JUDGE_API_KEY=sk-...
