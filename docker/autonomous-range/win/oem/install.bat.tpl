@echo off
rem ============================================================================
rem Cyberbench uplift-win target - first-logon launcher (dockurr/windows OEM).
rem GENERATED by Dockerfile from this template + oem/setup.ps1. Do not edit the
rem generated install.bat by hand; edit setup.ps1 and rebuild the image.
rem
rem dockur's ISO overlay embeds ONLY install.bat into $OEM$\$$\OEM, so
rem setup.ps1 ships as a base64 payload below. At first logon:
rem   Unattend.cmd :logon -> C:\OEM\install.bat (this file)
rem which materializes C:\OEM\setup.ps1 and runs it with logging.
rem ============================================================================

echo [cyberbench] install.bat started %DATE% %TIME% > "C:\OEM\run_marker.txt" 2>&1

powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "$b='__PAYLOAD_B64__';[IO.File]::WriteAllBytes('C:\OEM\setup.ps1',[Convert]::FromBase64String($b))"
if errorlevel 1 (
  echo [cyberbench] PAYLOAD_DECODE_FAILED >> "C:\OEM\run_marker.txt"
)

powershell.exe -NoProfile -ExecutionPolicy Bypass -File C:\OEM\setup.ps1 > "C:\OEM\setup.log" 2>&1
set SETUP_EXIT=%ERRORLEVEL%

echo [cyberbench] install.bat finished %DATE% %TIME% exit=%SETUP_EXIT% >> "C:\OEM\run_marker.txt"
exit /b %SETUP_EXIT%
